# Copy this file to .env.production on the VM. Do not commit .env.production.
POSTGRES_USER=lumina
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=lumina
API_PORT=3000
LOG_LEVEL=info
# Browser-visible same-origin Pages URLs. Replace the project slug.
SERVER_PUBLIC_URL=https://replace-with-project.pages.dev/api
WEB_ORIGIN=https://replace-with-project.pages.dev
# Generate exactly 32 random bytes, then base64 encode them.
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Paid AI calls are disabled by the zero-cost Compose profile.
# The existing application may return mock AI responses; this is not real AI.
AI_TOKEN_QUOTA_PER_WORKSPACE=1000000
